{
  "name": "dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build && mv ../internal/fw/static/index.html ../internal/fw/static/dashboard.html",
