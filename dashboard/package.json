    "svelte": "^5.55.4",
    "svelte-check": "^4.4.6",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "packageManager": "pnpm@10.33.2"
}
